rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- AUTHENTICATION & ROLE HELPERS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Resolves role either from Custom Claims (Zero read penalty) or fallback document read
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // --- USER ACCOUNTS & PASS SUBCOLLECTIONS ---
    match /users/{userId} {
      // Profile can be read by owner or admin
      allow read: if isOwner(userId) || isAdmin();
      // Allow self-registration without role tampering
      allow create: if isOwner(userId) &&
        request.resource.data.get('role', 'student') == 'student';

      // Updates: Prevent students from privilege-escalating to admin
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions'])
      );

      allow delete: if isAdmin();

      // Active Passes Subcollection (Controls access to specific Board & Grade)
      match /active_passes/{passId} {
        allow read: if isOwner(userId) || isAdmin();
        // Passes can ONLY be minted, renewed, or revoked by Admin/Automation pipelines
        allow create, update, delete: if isAdmin();
      }

      match /progress/{courseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- PAYMENT VERIFICATION PIPELINE (JAZZCASH / EASYPAISA / BANK) ---
    match /payment_verifications/{verificationId} {
      // Students view only their own records; Admins audit all
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());

      // Student initial submission guard: Enforce status == 'pending' and clean TID payload
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.tid is string &&
        request.resource.data.tid.size() >= 6 &&
        request.resource.data.rejectionReason == null;

      // Only Admins or backend Cloud Functions can transition status to 'approved' or 'rejected'
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- UNCLAIMED SMS / TID DEPOSITS LEDGER ---
    match /unclaimed_deposits/{depositTid} {
      allow read, write: if isAdmin();
    }

    // --- ACADEMIC CURRICULA & COURSE CHAPTERS ---
    match /curriculums/{stream} {
      allow read: if true;
      allow write: if isAdmin();

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();

        match /chapters/{chapterId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin();

          match /lectures/{lectureId} {
            allow read: if isAuthenticated();
            allow write: if isAdmin();
          }
        }
      }
    }

    // Legacy courses collection for backward compatibility
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Direct flat curriculum modules
    match /curriculum_modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SYSTEM CONFIGS & EXAM DEADLINES ---
    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Legacy payment requests
    match /payment_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Solved past papers
    match /past_papers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes
    match /promo_codes/{code} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- CS PRACTICAL LAB (Journals, Simulators, Solved Programs) ---
    match /practical_lab/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /experiments/{experimentId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // --- SYSTEM METADATA, BOARDS & SLUG REGISTRIES ---
    match /system_metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
